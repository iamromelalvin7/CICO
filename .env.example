# Copy to .env and fill in. .env is gitignored; never commit real values.

# Supabase (filled in at build step 6). VITE_ variables are bundled into the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Where "Forgot PIN?" sends the reset code (Supabase Auth email). Bundled into the browser.
VITE_RECOVERY_EMAIL=

# Groq: tried first for AI features when set. No VITE_ prefix: server-side only.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
# Optional model overrides. Defaults: openai/gpt-oss-20b (parse), openai/gpt-oss-120b (chat).
# The parse model must support structured outputs; the chat model must support tool calling.
GROQ_PARSE_MODEL=
GROQ_CHAT_MODEL=

# Gemini: fallback when Groq fails or hits its limit (or the only provider, if Groq isn't set). No VITE_ prefix: keep this key server-side only.
GEMINI_API_KEY=
# Optional model overrides. Defaults: gemini-3.5-flash-lite (parse), gemini-3.5-flash (chat).
# The parse model must support thinking level MINIMAL.
GEMINI_PARSE_MODEL=
GEMINI_CHAT_MODEL=
