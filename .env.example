# Copy to .env and fill in. .env is gitignored; never commit real values.

# Supabase (filled in at build step 6). VITE_ variables are bundled into the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Gemini (filled in at build steps 3 and 8). No VITE_ prefix: keep this key server-side only.
GEMINI_API_KEY=
