# Copy to .env and fill in. .env is gitignored; never commit real values.

# Supabase (filled in at build step 6). VITE_ variables are bundled into the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Where "Forgot PIN?" sends the reset code (Supabase Auth email). Bundled into the browser.
VITE_RECOVERY_EMAIL=

# Gemini (filled in at build steps 3 and 8). No VITE_ prefix: keep this key server-side only.
GEMINI_API_KEY=
# Optional model overrides. Defaults: gemini-3.5-flash-lite (parse), gemini-3.5-flash (chat).
# The parse model must support thinking level MINIMAL.
GEMINI_PARSE_MODEL=
GEMINI_CHAT_MODEL=
